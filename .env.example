# Production (tests/floorDetail, getPins, mostActiveToday, workersOnPlan).
BASE_URL=https://app.kwant.ai
KWANT_EMAIL=your-email@example.com
KWANT_PASSWORD=your-password
KWANT_PROJECT_ID=your-project-id

# QA (tests/qa*.spec.ts). Its own credentials — the specs never fall back to the
# KWANT_* pair above, so both of these are required to run the QA suite.
# QA_TIME_ZONE=auto follows whatever project-zone reports (UTC) instead.
QA_BASE_URL=https://qa.kwant.ai
QA_KWANT_EMAIL=your-qa-email@example.com
QA_KWANT_PASSWORD=your-qa-password

# Which QA project/plan the specs hit, and the window width, from the QA UI URL
# /projects/<projectId>/location/plan/<planId>. The two must match — a plan id
# under another project returns 400 "User is not authorized to this resource".
# All four have working defaults in the specs; set them only to point elsewhere.
QA_PROJECT_NAME="Frontier Data Center Project"
QA_PROJECT_ID=7801174067
QA_PLAN_ID=7819255146
# 14, not 15: the app's "last 15 days" filter sends a 14-day span — captured
# from the browser, it asks for 2026-08-07T05:00:00Z -> 2026-08-21T04:59:00Z,
# i.e. Aug 7 00:00 through Aug 20 23:59 local. The label counts boundaries.
QA_WINDOW_DAYS=14

# How those days are anchored:
#   calendarDay (default) - whole local days in the project's timezone,
#                           midnight (today-14) -> 23:59 today. Emits the
#                           05:00Z/04:59Z boundaries the UI URLs use; the end is
#                           the last minute of today, so slightly in the future.
#   rolling               - the present instant back 15x24h, now-15d -> now.
#                           Timezone-independent: "now" is one instant everywhere.
QA_WINDOW_MODE=calendarDay

# Leave unset to follow GET /api/project-zone (America/Chicago for the project
# above). An IANA name here forces the window's calendar days into that zone.
# QA_TIME_ZONE=America/Chicago

# UAT (tests/uat*.spec.ts). A copy of the QA block pointed at uat.kwant.ai.
# Credentials are optional: unset, the specs use the QA_KWANT_* pair above, which
# is authorised on both environments. Set them to point UAT at a different
# account — one that can open the plan below in the UAT UI. Neither pair ever
# falls back to the production KWANT_* one.
UAT_BASE_URL=https://uat.kwant.ai
# UAT_KWANT_EMAIL=your-uat-email@example.com
# UAT_KWANT_PASSWORD=your-uat-password

# Same ids as QA — UAT is a clone of the same environment, so the pair from the
# UI URL /projects/<projectId>/location/plan/<planId> is identical. They still
# travel together: a plan id under another project returns 400.
UAT_PROJECT_NAME="Frontier Data Center Project"
UAT_PROJECT_ID=7801174067
UAT_PLAN_ID=7819255146
UAT_WINDOW_DAYS=14
UAT_WINDOW_MODE=calendarDay
# Leave unset to follow GET /api/project-zone, which reports America/Chicago
# here as well.
# UAT_TIME_ZONE=America/Chicago
